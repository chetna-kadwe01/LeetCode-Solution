class Solution {
Public int maxSubArray(int [] nums){
        int sum = 0;
        int maxs = nums[0];
        for(int i = 0; i< nums.length;i++){
            sum += nums[i];
            maxs = Math.max(sum,maxs);
            if(sum < 0){
                sum = 0;
            }
            
        }
       return maxs;
        
    }
}
