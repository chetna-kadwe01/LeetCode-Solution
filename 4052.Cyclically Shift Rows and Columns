class Solution {
    public int[][] cyclicShift(int n, int[][] grid, int[] rowShift, int[] colShift) {
        int[][] temp = new int[n][n];
        int[][] ans = new int[n][n];

        // Step 1: Shift rows to the left
        for (int i = 0; i < n; i++) {
            int k = rowShift[i] % n;
            for (int j = 0; j < n; j++) {
                temp[i][j] = grid[i][(j + k) % n];
            }
        }

        // Step 2: Shift columns upward
        for (int j = 0; j < n; j++) {
            int k = colShift[j] % n;
            for (int i = 0; i < n; i++) {
                ans[i][j] = temp[(i + k) % n][j];
            }
        }

        return ans;
    }
}
